page{background:#f5f7f2;color:#20352e}.page{min-height:100vh;padding:24rpx 28rpx 48rpx}.card{background:#fff;border-radius:30rpx;box-shadow:0 12rpx 40rpx rgba(40,80,60,.08)}.header-row{display:flex;justify-content:space-between;align-items:flex-start;padding:28rpx 4rpx 24rpx}.eyebrow,.date{display:block;color:#7a8d85;font-size:25rpx}.headline{display:block;font-size:44rpx;font-weight:800;margin-top:10rpx;letter-spacing:-1rpx}.progress{display:flex;justify-content:space-between;align-items:center;color:#fff;padding:34rpx 36rpx;background:linear-gradient(135deg,#246b58,#3e8b70)}.small-light{display:block;font-size:24rpx;opacity:.82}.progress-number{font-size:76rpx;font-weight:800;line-height:1.2;margin:6rpx 0}.progress-number text{font-size:34rpx;opacity:.72;margin-left:6rpx}.ring{position:relative;width:150rpx;height:150rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:conic-gradient(#f7d88a 0 0%,rgba(255,255,255,.2) 0)}.ring:after{content:'';position:absolute;width:124rpx;height:124rpx;border-radius:50%;background:#347c65}.ring text{position:relative;z-index:1;font-weight:800}.section-row{display:flex;align-items:center;justify-content:space-between;margin:44rpx 4rpx 20rpx}.section-title{font-size:36rpx;font-weight:800}.add-button{margin:0;padding:0 22rpx;background:#e3efe8;color:#276b56;border-radius:18rpx;font-size:26rpx;line-height:70rpx}.task{display:grid;grid-template-columns:76rpx 1fr 50rpx;align-items:center;padding:24rpx 20rpx;margin-bottom:18rpx}.task.done{opacity:.62}.check{width:54rpx;height:54rpx;padding:0;border:3rpx solid #bad0c6;border-radius:50%;background:#fff;color:#fff;font-size:32rpx;line-height:48rpx}.check.checked{background:#428b70;border-color:#428b70}.task-content{min-width:0}.task-title{display:block;font-size:31rpx;font-weight:700}.task-desc{display:block;color:#8a9993;font-size:24rpx;margin-top:8rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.more{padding:0;background:transparent;color:#789087;font-size:52rpx;line-height:1}.empty,.loading{padding:56rpx 30rpx;text-align:center;color:#809087;font-size:28rpx}.setup-card{margin:120rpx 12rpx 0;padding:58rpx 42rpx;text-align:center}.brand-mark{width:116rpx;height:116rpx;border-radius:34rpx;background:#2d745c;color:#fff;line-height:116rpx;font-size:68rpx;margin:0 auto 28rpx}.title{display:block;font-size:48rpx;font-weight:800}.muted{display:block;color:#77877f;font-size:26rpx;line-height:1.6;margin:22rpx 0}.stack{display:grid;gap:20rpx;margin-top:34rpx}.primary,.secondary,.danger,.photo-button{border:0;border-radius:22rpx;font-size:30rpx;font-weight:700;line-height:88rpx}.primary{background:#2e755d;color:#fff}.secondary{background:#e7f0eb;color:#28654f}.danger{background:#fff0ef;color:#b14a45}.link{border:0;background:transparent;color:#2d745c;font-size:28rpx}.input,.textarea,.picker{width:100%;box-sizing:border-box;border:2rpx solid #dce5df;border-radius:18rpx;background:#fafcfa;padding:24rpx;font-size:28rpx;margin-bottom:18rpx}.code-input{letter-spacing:8rpx;text-align:center}.message{display:block;background:#fff7db;color:#766223;padding:20rpx;border-radius:16rpx;font-size:24rpx;line-height:1.5;margin-top:18rpx}.page-message{margin:20rpx 4rpx}.overlay{position:fixed;z-index:20;inset:0;background:rgba(16,38,30,.42);display:flex;align-items:flex-end}.sheet{width:100%;box-sizing:border-box;background:#fff;border-radius:34rpx 34rpx 0 0;padding:46rpx 34rpx calc(52rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:18rpx}.sheet-title{font-size:40rpx;font-weight:800;margin-bottom:14rpx}.close{position:absolute;right:28rpx;top:18rpx;border:0;background:transparent;color:#789087;font-size:52rpx}.textarea{height:190rpx}.photo-button{background:#edf5f0;color:#4a7464}.celebration{position:fixed;z-index:30;left:50%;top:50%;transform:translate(-50%,-50%);width:520rpx;padding:54rpx 34rpx;text-align:center;background:#fff;border-radius:34rpx;box-shadow:0 24rpx 80rpx rgba(25,61,44,.25)}.burst{width:120rpx;height:120rpx;border-radius:50%;line-height:120rpx;background:#3f9271;color:#fff;font-size:70rpx;margin:0 auto 20rpx}.celebration-title{display:block;color:#24644e;font-size:38rpx;font-weight:800}@media (min-width:700px){.page{max-width:760px;margin:0 auto}}

