.page{min-height:100vh;padding:32rpx 28rpx 150rpx;background:#f5f7f2;box-sizing:border-box}.header-row{display:flex;justify-content:space-between;align-items:flex-end;margin:18rpx 8rpx 30rpx}.eyebrow{display:block;color:#789187;font-size:24rpx;margin-bottom:12rpx}.headline{display:block;color:#173b34;font-size:42rpx;font-weight:700}.card{background:#fff;border-radius:28rpx;box-shadow:0 10rpx 35rpx rgba(37,73,62,.06)}.record{padding:26rpx 28rpx;margin-bottom:20rpx}.record-top{display:flex;justify-content:space-between;gap:18rpx;align-items:center}.task-title{color:#173b34;font-size:30rpx;font-weight:700}.record-date{color:#8b9a95;font-size:22rpx}.task-desc{display:block;color:#7b8a85;font-size:25rpx;line-height:1.5;margin-top:12rpx}.record-photo{width:100%;height:300rpx;border-radius:18rpx;margin-top:18rpx}.empty{padding:80rpx 28rpx;text-align:center;color:#7b8a85;font-size:28rpx}.loading{text-align:center;color:#7b8a85;padding:100rpx 20rpx}.message{color:#a34f49;background:#fff0ed;border-radius:16rpx;padding:20rpx 24rpx}.page-message{margin-top:20rpx}

