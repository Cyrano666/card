.page{min-height:100vh;padding:32rpx 28rpx 150rpx;background:#f5f7f2;box-sizing:border-box}.card{background:#fff;border-radius:28rpx;box-shadow:0 10rpx 35rpx rgba(37,73,62,.06)}.hero{padding:48rpx 28rpx 32rpx;text-align:center}.brand-mark{width:96rpx;height:96rpx;border-radius:28rpx;background:#2d725b;color:#fff;display:flex;align-items:center;justify-content:center;font-size:52rpx;margin:0 auto 24rpx}.headline{display:block;color:#173b34;font-size:42rpx;font-weight:700}.muted{display:block;color:#7b8a85;font-size:25rpx;line-height:1.6;margin-top:20rpx}.invite-label{display:block;color:#91a19a;font-size:23rpx;margin-top:30rpx}.invite{margin-top:10rpx;padding:24rpx;border-radius:16rpx;background:#edf6f1;color:#2d725b;font-size:42rpx;letter-spacing:10rpx;font-weight:700}.primary,.secondary,.outline{border:0;border-radius:18rpx;font-size:30rpx;font-weight:600}.primary{background:#2d725b;color:#fff}.hero .primary{margin-top:20rpx}.profile{padding:28rpx;margin-top:20rpx}.section-title{display:block;color:#788982;font-size:24rpx}.profile-name{display:block;color:#173b34;font-size:34rpx;font-weight:700;margin-top:12rpx}.task-desc{display:block;color:#7b8a85;font-size:25rpx;line-height:1.5;margin-top:12rpx}.full{width:100%;margin-top:20rpx}.secondary{background:#fff0ed;color:#a34f49}.outline{background:#fff;color:#a34f49;border:1rpx solid #ead3cf}.empty{padding:80rpx 28rpx;text-align:center;color:#7b8a85;font-size:28rpx}.loading{text-align:center;color:#7b8a85;padding:100rpx 20rpx}.message{color:#a34f49;background:#fff0ed;border-radius:16rpx;padding:20rpx 24rpx}.page-message{margin-top:20rpx}

